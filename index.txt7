   <style amp-custom>
/* =========================================================
   ROKOKBET AMP
   PREMIUM BLACK × METALLIC GOLD
========================================================= */

* {
   box-sizing: border-box;
}

html,
body {
   margin: 0;
   padding: 0;
   min-height: 100%;
}

body {
   font-family: monospace;
   position: relative;
   min-height: 100vh;
   overflow-x: hidden;

   color: #fff0a6;

   background:
      radial-gradient(
         circle at 50% 18%,
         rgba(255, 215, 0, .13) 0%,
         rgba(212, 175, 55, .07) 18%,
         transparent 42%
      ),
      radial-gradient(
         circle at 10% 80%,
         rgba(155, 116, 13, .10) 0%,
         transparent 35%
      ),
      radial-gradient(
         circle at 90% 75%,
         rgba(255, 215, 0, .07) 0%,
         transparent 32%
      ),
      linear-gradient(
         160deg,
         #000000 0%,
         #080704 42%,
         #000000 100%
      );

   background-attachment: fixed;
}


/* =========================================================
   BACKGROUND GRID
========================================================= */

body::before {
   content: "";
   position: fixed;
   inset: 0;

   pointer-events: none;
   z-index: 0;

   background-image:
      linear-gradient(
         rgba(255, 215, 0, .025) 1px,
         transparent 1px
      ),
      linear-gradient(
         90deg,
         rgba(255, 215, 0, .025) 1px,
         transparent 1px
      );

   background-size: 30px 30px;

   mask-image:
      linear-gradient(
         to bottom,
         rgba(0,0,0,.8),
         transparent
      );
}


/* =========================================================
   AMBIENT GOLD GLOW
========================================================= */

body::after {
   content: "";
   position: fixed;

   width: 320px;
   height: 320px;

   left: 50%;
   top: 40%;

   transform: translate(-50%, -50%);

   border-radius: 50%;

   background:
      radial-gradient(
         circle,
         rgba(255, 215, 0, .12) 0%,
         rgba(212, 175, 55, .05) 38%,
         transparent 70%
      );

   filter: blur(25px);

   pointer-events: none;
   z-index: 0;

   animation: ambientGlow 5s ease-in-out infinite alternate;
}

@keyframes ambientGlow {
   0% {
      opacity: .55;
      transform:
         translate(-50%, -50%)
         scale(.9);
   }

   100% {
      opacity: 1;
      transform:
         translate(-50%, -50%)
         scale(1.15);
   }
}


/* =========================================================
   MAIN CONTAINER
========================================================= */

.container {
   position: relative;
   z-index: 1;

   max-width: 420px;
   min-height: 100vh;
   height: auto;

   margin: 0 auto;

   padding:
      22px
      16px;

   display: flex;
   flex-direction: column;
   justify-content: center;

   overflow: hidden;
}


/* GOLD LINE AT TOP */

.container::before {
   content: "";

   position: absolute;

   top: 0;
   left: 50%;

   width: 70%;
   height: 1px;

   transform: translateX(-50%);

   background:
      linear-gradient(
         90deg,
         transparent,
         #7a5700,
         #ffd700,
         #fff0a6,
         #ffd700,
         #7a5700,
         transparent
      );

   box-shadow:
      0 0 7px rgba(255, 215, 0, .55),
      0 0 18px rgba(212, 175, 55, .25);
}


/* =========================================================
   WELCOME / TYPEWRITER
========================================================= */

.welcome {
   width: 100%;
   max-width: 370px;

   margin:
      0 auto
      12px;

   text-align: center;
}

.welcome h3 {
   display: inline-block;

   max-width: 100%;

   margin:
      0 auto
      8px;

   padding:
      6px
      4px;

   overflow: hidden;

   font-size: 12px;
   font-weight: 700;

   color: #ffd700;

   border-right:
      .15em solid
      #fff0a6;

   white-space: nowrap;

   letter-spacing: .09em;

   text-shadow:
      0 0 4px rgba(255, 215, 0, .75),
      0 0 12px rgba(212, 175, 55, .35);

   animation:
      typing 3.5s steps(40, end),
      blink-caret .75s step-end infinite;
}


@keyframes typing {
   from {
      width: 0;
   }

   to {
      width: 100%;
   }
}


@keyframes blink-caret {
   from,
   to {
      border-color: transparent;
   }

   50% {
      border-color: #fff0a6;
   }
}


/* =========================================================
   BANNER
========================================================= */

.banner {
   position: relative;

   display: block;

   width: 100%;

   border-radius: 14px;

   border:
      1px solid
      #d4af37;

   overflow: hidden;

   background:
      #050505;

   box-shadow:
      0 0 0 1px rgba(255, 215, 0, .08),
      0 0 10px rgba(255, 215, 0, .22),
      0 0 30px rgba(212, 175, 55, .12),
      0 14px 30px rgba(0, 0, 0, .85);

   animation:
      bannerGlow
      3s ease-in-out
      infinite alternate;
}


@keyframes bannerGlow {
   0% {
      border-color:
         #7a5700;

      box-shadow:
         0 0 5px rgba(212, 175, 55, .18),
         0 12px 25px rgba(0, 0, 0, .80);
   }

   100% {
      border-color:
         #ffd700;

      box-shadow:
         0 0 9px rgba(255, 215, 0, .38),
         0 0 22px rgba(212, 175, 55, .16),
         0 14px 30px rgba(0, 0, 0, .90);
   }
}


/* =========================================================
   LOGIN BUTTON
========================================================= */

.btn-login {
   position: relative;
   z-index: 2;

   display: block;

   width: 100%;

   margin-top: 14px;

   padding:
      12px
      10px;

   overflow: hidden;

   color:
      #fff0a6;

   font-size:
      18px;

   font-weight:
      800;

   letter-spacing:
      1px;

   text-decoration:
      none;

   text-align:
      center;

   text-transform:
      uppercase;

   background:
      linear-gradient(
         180deg,
         #17130a 0%,
         #090909 48%,
         #000000 100%
      );

   border:
      1px solid
      #d4af37;

   border-radius:
      10px;

   box-shadow:
      inset 0 1px 0 rgba(255, 240, 166, .12),
      inset 0 -2px 6px rgba(122, 87, 0, .18),
      0 0 7px rgba(212, 175, 55, .20),
      0 7px 16px rgba(0, 0, 0, .65);

   text-shadow:
      0 0 5px rgba(255, 215, 0, .30);

   transition:
      .25s ease;
}


/* LOGIN SHINE */

.btn-login::before {
   content: "";

   position: absolute;

   top: 0;
   left: -120%;

   width: 65%;
   height: 100%;

   background:
      linear-gradient(
         110deg,
         transparent,
         rgba(255, 240, 166, .18),
         transparent
      );

   transform:
      skewX(-20deg);

   animation:
      goldShine
      4s ease-in-out
      infinite;
}


.btn-login:hover {
   color:
      #ffd700;

   border-color:
      #ffd700;

   transform:
      translateY(-1px);

   box-shadow:
      0 0 8px rgba(255, 215, 0, .55),
      0 0 22px rgba(212, 175, 55, .20),
      0 8px 18px rgba(0, 0, 0, .75);
}


/* =========================================================
   DAFTAR BUTTON
========================================================= */

.btn-daftar {
   position: relative;
   z-index: 2;

   display: block;

   width: 100%;

   margin-top:
      10px;

   padding:
      12px
      10px;

   overflow:
      hidden;

   color:
      #000000;

   font-size:
      18px;

   font-weight:
      900;

   letter-spacing:
      1px;

   text-decoration:
      none;

   text-align:
      center;

   text-transform:
      uppercase;

   background:
      linear-gradient(
         135deg,
         #7a5700 0%,
         #d4af37 20%,
         #fff0a6 42%,
         #ffd700 58%,
         #d4af37 78%,
         #7a5700 100%
      );

   background-size:
      200% 200%;

   border:
      1px solid
      #fff0a6;

   border-radius:
      10px;

   box-shadow:
      inset 0 1px 0 rgba(255,255,255,.55),
      inset 0 -3px 7px rgba(122,87,0,.45),
      0 0 8px rgba(255,215,0,.45),
      0 0 22px rgba(212,175,55,.18),
      0 8px 18px rgba(0,0,0,.75);

   text-shadow:
      0 1px 0 rgba(255,240,166,.45);

   animation:
      goldGradient
      4s ease
      infinite;

   transition:
      .25s ease;
}


/* DAFTAR SHINE */

.btn-daftar::before {
   content: "";

   position: absolute;

   top: 0;
   left: -120%;

   width: 70%;
   height: 100%;

   background:
      linear-gradient(
         110deg,
         transparent,
         rgba(255,255,255,.55),
         transparent
      );

   transform:
      skewX(-20deg);

   animation:
      goldShine
      3.5s ease-in-out
      infinite;
}


.btn-daftar:hover {
   transform:
      translateY(-2px);

   filter:
      brightness(1.12);

   box-shadow:
      0 0 10px rgba(255,215,0,.75),
      0 0 28px rgba(212,175,55,.35),
      0 10px 22px rgba(0,0,0,.80);
}


/* =========================================================
   GOLD ANIMATIONS
========================================================= */

@keyframes goldShine {
   0% {
      left: -120%;
   }

   45% {
      left: -120%;
   }

   70% {
      left: 140%;
   }

   100% {
      left: 140%;
   }
}


@keyframes goldGradient {
   0% {
      background-position:
         0% 50%;
   }

   50% {
      background-position:
         100% 50%;
   }

   100% {
      background-position:
         0% 50%;
   }
}


/* =========================================================
   COPYRIGHT
========================================================= */

.copyright {
   position: relative;

   margin-top:
      18px;

   padding-top:
      13px;

   text-align:
      center;

   color:
      rgba(255, 240, 166, .60);

   font-size:
      11px;

   line-height:
      1.6;

   letter-spacing:
      .4px;
}


.copyright::before {
   content: "";

   position: absolute;

   top: 0;
   left: 50%;

   width: 75%;
   height: 1px;

   transform:
      translateX(-50%);

   background:
      linear-gradient(
         90deg,
         transparent,
         #7a5700,
         #d4af37,
         #ffd700,
         #d4af37,
         #7a5700,
         transparent
      );

   opacity:
      .65;
}


/* =========================================================
   MOBILE OPTIMIZATION
========================================================= */

@media (max-width: 480px) {

   .container {
      max-width:
         400px;

      padding:
         15px;
   }

   .welcome h3 {
      font-size:
         11px;

      letter-spacing:
         .06em;
   }

   .banner {
      border-radius:
         12px;
   }

   .btn-login,
   .btn-daftar {
      font-size:
         17px;

      padding:
         11px 10px;
   }
}


/* =========================================================
   SMALL SCREEN HEIGHT
========================================================= */

@media (max-height: 650px) {

   .container {
      justify-content:
         flex-start;

      padding-top:
         18px;

      padding-bottom:
