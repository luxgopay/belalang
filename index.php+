        <script id="NOTA4D-layout-runtime" defer>
        (()=>{const d=document,nav=d.querySelector('.bmd-navbar'),footer=d.querySelector('.NOTA4D-footer');const sync=()=>nav?.classList.toggle('is-scrolled',scrollY>8);addEventListener('scroll',sync,{passive:true});sync();footer?.querySelectorAll('.social-list img').forEach(img=>{img.width=22;img.height=22;img.loading='lazy';img.decoding='async'});footer?.querySelectorAll('img[alt="Tautan Google Play Store"]').forEach(img=>{img.width=134;img.height=40;img.decoding='async'});footer?.classList.add('is-ready');const links=[...d.querySelectorAll('#productAdditionalDataNavigation a')];links.forEach(a=>{let id='';try{id=new URL(a.href,location.href).pathname.split('/').filter(Boolean).pop()||''}catch{}const target=d.getElementById(id);if(target){a.href='#'+id;a.addEventListener('click',e=>{e.preventDefault();target.scrollIntoView({behavior:'smooth',block:'start'})})}});if('IntersectionObserver'in window){const observer=new IntersectionObserver(items=>items.forEach(item=>{if(item.isIntersecting){links.forEach(a=>a.classList.toggle('is-active',a.hash==='#'+item.target.id))}}),{rootMargin:'-22% 0px -68%'});d.querySelectorAll('#productAdditionalDataContainer [id]').forEach(el=>observer.observe(el))}})();
        </script>
        
        
