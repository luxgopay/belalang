min(1180px,calc(100% - 32px));padding:18px 0 24px!important;border-top:1px solid #2c3038;color:#9298a4;font-size:13px;text-align:center}#copyrightWrapper .row{justify-content:center!important;margin:0}#copyrightWrapper .col-12{display:flex;justify-content:center!important;padding:3px 0}#copyrightWrapper svg{display:block;width:116px;height:24px;margin:auto}#copyrightWrapper svg image{width:116px;height:22px}.NOTA4D-footer.is-ready .social-list img{visibility:visible}
